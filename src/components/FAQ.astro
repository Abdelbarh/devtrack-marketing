---
const faqs = [
  {
    q: 'Is DevTrack only for developers?',
    a: 'DevTrack is built around developer workflows, technical skills, tech stacks, and software roles. The parsing, scoring, and tailoring features are designed with engineering job descriptions in mind.',
  },
  {
    q: 'Do I need to connect my GitHub?',
    a: 'Not required. GitHub-based matching can improve scoring accuracy, but you can start by using your profile and job descriptions alone.',
  },
  {
    q: 'Can I use it for free?',
    a: 'Yes. The free plan lets you track up to 50 applications, use basic JD parsing and match scoring, manage your pipeline, and set follow-up reminders — no credit card needed.',
  },
  {
    q: 'Does DevTrack apply to jobs for me?',
    a: 'No. DevTrack helps you prepare, organize, tailor, and track. You stay in control of where and how you apply.',
  },
];
---
<section id="faq" class="py-20 px-6 bg-[#0e0e11] border-y border-[#1e1e22]">
  <div class="max-w-container mx-auto">

    <div class="grid lg:grid-cols-[280px_1fr] gap-12 lg:gap-16">

      <!-- Left label -->
      <div class="lg:pt-1">
        <div data-animate class="mb-2">
          <span class="text-xs font-semibold text-[#a3e635] uppercase tracking-widest">FAQ</span>
        </div>
        <h2
          data-animate
          data-delay="1"
          class="text-2xl sm:text-3xl font-bold text-[#f0f0f0] leading-tight tracking-tight"
        >
          Common questions
        </h2>
        <p
          data-animate
          data-delay="2"
          class="mt-3 text-sm text-[#5a5a64]"
        >
          Something else? <a href="mailto:hello@devtrack.app" class="text-[#a0a0a8] hover:text-[#f0f0f0] underline underline-offset-2 transition-colors">Email us.</a>
        </p>
      </div>

      <!-- Right: Accordion -->
      <div data-animate data-delay="1" class="flex flex-col divide-y divide-[#1e1e22]">
        {faqs.map((faq, i) => (
          <div>
            <button
              data-faq-trigger
              class="w-full flex items-start justify-between gap-4 py-5 text-left group cursor-pointer"
              aria-expanded="false"
            >
              <span class="text-[15px] font-medium text-[#f0f0f0] group-hover:text-white transition-colors leading-snug">
                {faq.q}
              </span>
              <svg
                class="faq-icon flex-shrink-0 mt-0.5 text-[#5a5a64] group-hover:text-[#a0a0a8] transition-colors"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            <div class="faq-answer pb-5">
              <p class="text-sm text-[#a0a0a8] leading-relaxed">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
