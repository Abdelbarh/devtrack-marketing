---
const faqs = [
  {
    q: 'Do you use my data to train AI models?',
    a: 'No. Your CV, cover letters, job descriptions, and application data are used only to generate your specific outputs — nothing else. We do not use your data to train AI models, not ours, not any third-party model provider\'s. This is a firm policy, not a setting you need to configure.',
    tag: 'Privacy',
  },
  {
    q: 'Is my data shared with recruiters, job boards, or third parties?',
    a: 'Never. Your data is private to you. We do not sell it, share it with recruiters, link it to job boards or staffing agencies, or connect it to any external database. We have no commercial interest in your personal information — our only revenue is your subscription.',
    tag: 'Privacy',
  },
  {
    q: 'Can I delete my account and all my data?',
    a: 'Yes, anytime. You can permanently delete your account and every piece of data associated with it — applications, documents, cover letters, notes — directly from your settings. Deletion is instant. There is no waiting period, no "we\'ll delete it within 30 days" language. It\'s gone immediately.',
    tag: 'Privacy',
  },
  {
    q: 'What data protection standards do you follow?',
    a: 'DevTrack is built with GDPR compliance in mind. You have the right to access, correct, export, and erase your data. If you have a specific request or concern, contact us at privacy@devtrack.app and we will respond promptly.',
    tag: 'Privacy',
  },
  {
    q: 'Is DevTrack only for developers?',
    a: 'DevTrack is built around developer workflows — technical skills, tech stacks, and software engineering roles. The parsing, scoring, and tailoring features are designed with engineering job descriptions in mind. That said, anyone in a technical or product role will find it useful.',
    tag: 'Product',
  },
  {
    q: 'Do I need to connect my GitHub?',
    a: 'No. GitHub integration improves cover letter personalization by pulling your actual project work, but it is entirely optional. You can start using DevTrack with just your CV and the job descriptions you paste in.',
    tag: 'Product',
  },
  {
    q: 'Can I use it for free?',
    a: 'Yes. The free plan lets you track up to 50 applications, use basic JD parsing and match scoring, manage your pipeline, and set follow-up reminders — no credit card needed. Pro unlocks cover letter generation, unlimited applications, and resume tailoring.',
    tag: 'Pricing',
  },
  {
    q: 'Does DevTrack apply to jobs automatically?',
    a: 'No. DevTrack helps you prepare, organize, tailor, and track. You stay in control of where and how you apply. We believe a thoughtful, targeted application beats bulk-applying by a significant margin.',
    tag: 'Product',
  },
];
---
<section id="faq" class="py-20 px-6 bg-[#0A0D1A] border-y border-[#1A1E32]">
  <div class="max-w-container mx-auto">

    <div class="grid lg:grid-cols-[300px_1fr] gap-12 lg:gap-16">

      <!-- Left label -->
      <div class="lg:pt-1">
        <p data-animate class="text-xs font-semibold text-[#6366F1] uppercase tracking-widest mb-4 font-display">FAQ</p>
        <h2 data-animate data-delay="1" class="font-display text-2xl sm:text-3xl font-bold text-[#E8EEFF] leading-tight">Common questions</h2>
        <p data-animate data-delay="2" class="mt-3 text-sm text-[#4A5080] leading-relaxed">
          Especially around how we handle your data.
        </p>
        <p data-animate data-delay="3" class="mt-4 text-sm text-[#3D4468]">
          Something else? <a href="mailto:hello@devtrack.app" class="text-[#7B82AF] hover:text-[#818CF8] underline underline-offset-2 transition-colors">Email us.</a>
        </p>

        <!-- Trust badge -->
        <div data-animate data-delay="4" class="mt-8 p-4 bg-[#0D1020] border border-[#212840] rounded-xl">
          <div class="flex items-center gap-2.5 mb-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#818CF8" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span class="text-xs font-semibold text-[#818CF8]">Our data promise</span>
          </div>
          <ul class="flex flex-col gap-1.5">
            {['No AI training on your data', 'No third-party sharing', 'Delete anytime, instantly', 'GDPR compliant'].map(item => (
              <li class="flex items-center gap-2 text-xs text-[#4A5080]">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Accordion -->
      <div data-animate data-delay="1" class="flex flex-col divide-y divide-[#1A1E32]">
        {faqs.map((faq) => (
          <div>
            <button
              data-faq-trigger
              class="w-full flex items-start justify-between gap-4 py-5 text-left group cursor-pointer"
              aria-expanded="false"
            >
              <div class="flex items-start gap-3 min-w-0">
                <span class="mt-0.5 flex-shrink-0 px-1.5 py-0.5 text-[9px] font-semibold rounded uppercase tracking-wide" style={`color:${faq.tag === 'Privacy' ? '#818CF8' : faq.tag === 'Pricing' ? '#F59E0B' : '#10B981'};background:${faq.tag === 'Privacy' ? '#818CF818' : faq.tag === 'Pricing' ? '#F59E0B18' : '#10B98118'}`}>{faq.tag}</span>
                <span class="text-[15px] font-medium text-[#C7CBF0] group-hover:text-[#E8EEFF] transition-colors leading-snug">{faq.q}</span>
              </div>
              <svg
                class="faq-icon flex-shrink-0 mt-0.5 text-[#3D4468] group-hover:text-[#7B82AF] transition-colors"
                width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            <div class="faq-answer pb-5">
              <p class="text-sm text-[#7B82AF] leading-relaxed pl-[52px]">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
