---
const steps = [
  {
    numeral: '1',
    title: 'Paste any job description',
    description: 'Raw text, copied straight from LinkedIn, Greenhouse, Lever — whatever. No formatting needed. Just paste and go.',
    tag: '< 2 seconds to parse',
  },
  {
    numeral: '2',
    title: 'Get your match score',
    description: 'It reads the JD and your profile. You get a 0–100 fit score, the parsed tech stack, salary range, seniority level, and remote policy — structured, readable, saved.',
    tag: 'scored before you apply',
  },
  {
    numeral: '3',
    title: 'Generate and apply',
    description: 'One click. Tailored resume + cover letter, specific to this JD and your actual GitHub projects. Export as PDF. Apply. Done.',
    tag: 'PDF export ready',
  },
];
---
<section id="how-it-works" class="py-24 px-5 sm:px-8 border-t border-[#1a1a1a]">
  <div class="max-w-5xl mx-auto">

    <p data-animate class="text-sm text-[#525252] mb-5">how it works</p>

    <h2
      data-animate
      data-delay="100"
      class="font-serif text-3xl sm:text-4xl text-[#F5F0E8] leading-tight"
    >
      Three steps. That's it.
    </h2>

    <p
      data-animate
      data-delay="200"
      class="mt-4 text-[#525252] max-w-sm text-sm"
    >
      No onboarding wizard. No 12-step setup. Paste a JD and you're running.
    </p>

    <!-- Steps grid -->
    <div
      data-stagger
      class="mt-14 grid sm:grid-cols-3 gap-px bg-[#1a1a1a] border border-[#1a1a1a] rounded-lg overflow-hidden"
    >
      {steps.map((s) => (
        <div data-animate class="relative bg-[#0f0f0f] p-8 sm:p-10 overflow-hidden">

          <!-- Large background numeral -->
          <span
            class="absolute top-2 right-4 font-serif text-[130px] leading-none text-[#F5F0E8] pointer-events-none select-none"
            style="opacity: 0.04;"
            aria-hidden="true"
          >{s.numeral}</span>

          <!-- Content -->
          <div class="relative">
            <h3 class="text-base font-medium text-[#F5F0E8] leading-snug mb-3">{s.title}</h3>
            <p class="text-sm text-[#525252] leading-relaxed mb-5">{s.description}</p>
            <span class="inline-block px-2.5 py-1 border border-[#222] text-xs text-[#525252] rounded font-sans">
              {s.tag}
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
