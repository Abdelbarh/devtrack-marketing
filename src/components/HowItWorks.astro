---
const steps = [
  {
    num: '01',
    title: 'Paste a job description',
    text: 'Drop in a job post from LinkedIn, company career pages, or any job board.',
    detail: 'Any source works',
  },
  {
    num: '02',
    title: 'Review extracted insights',
    text: 'DevTrack identifies role details, tech stack, seniority, location, salary, and fit signals.',
    detail: 'Structured in seconds',
  },
  {
    num: '03',
    title: 'Track and tailor',
    text: 'Save the application, generate tailored materials, and move it through your pipeline.',
    detail: 'One workflow, start to offer',
  },
];
---
<section id="how-it-works" class="py-20 px-6 bg-[#0e0e11] border-y border-[#1e1e22]">
  <div class="max-w-container mx-auto">

    <div class="text-center mb-12">
      <div data-animate class="mb-3">
        <span class="text-xs font-semibold text-[#a3e635] uppercase tracking-widest">How it works</span>
      </div>
      <h2
        data-animate
        data-delay="1"
        class="text-3xl sm:text-[2.25rem] font-bold text-[#f0f0f0] leading-tight tracking-tight"
      >
        From job post to offer in three steps
      </h2>
      <p
        data-animate
        data-delay="2"
        class="mt-4 text-[16px] text-[#a0a0a8] max-w-md mx-auto"
      >
        A repeatable workflow for every role you consider.
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-5 relative">

      <!-- Connecting line (desktop) -->
      <div class="hidden sm:block absolute top-8 left-[calc(16.67%+1.25rem)] right-[calc(16.67%+1.25rem)] h-px bg-[#26262b]" aria-hidden="true"></div>

      {steps.map((s, i) => (
        <div
          data-animate
          data-delay={String(i)}
          class="relative flex flex-col p-7 bg-[#131316] border border-[#26262b] rounded-xl"
        >
          <!-- Step number -->
          <div class="relative z-10 w-10 h-10 rounded-full border border-[#26262b] bg-[#1a1a1e] flex items-center justify-center mb-5 flex-shrink-0">
            <span class="text-xs font-bold text-[#a3e635] tabular-nums">{s.num}</span>
          </div>

          <h3 class="text-base font-semibold text-[#f0f0f0] mb-2 leading-snug">{s.title}</h3>
          <p class="text-sm text-[#a0a0a8] leading-relaxed flex-1">{s.text}</p>

          <div class="mt-5 flex items-center gap-2 text-xs text-[#5a5a64]">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            {s.detail}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
