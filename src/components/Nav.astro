---
---
<nav
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-all duration-300"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
        <div class="w-7 h-7 bg-[#C8A96E] rounded-md flex items-center justify-center font-bold text-[#0f0f0f] text-sm leading-none select-none">
          D
        </div>
        <span class="font-medium text-[#F5F0E8] text-sm tracking-tight">DevTrack</span>
      </a>

      <!-- Desktop nav links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#features" class="text-sm text-[#525252] hover:text-[#9a9a9a] transition-colors duration-150">Features</a>
        <a href="#how-it-works" class="text-sm text-[#525252] hover:text-[#9a9a9a] transition-colors duration-150">How it works</a>
        <a href="#pricing" class="text-sm text-[#525252] hover:text-[#9a9a9a] transition-colors duration-150">Pricing</a>
      </div>

      <!-- Desktop CTA -->
      <div class="hidden md:block">
        <a
          href="#"
          class="px-4 py-2 bg-[#F5F0E8] hover:bg-white text-[#0f0f0f] text-sm font-medium rounded-md transition-colors duration-150 inline-block"
        >
          Get started free
        </a>
      </div>

      <!-- Mobile button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-1.5 text-[#525252] hover:text-[#9a9a9a] transition-colors"
        aria-label="Toggle navigation"
      >
        <svg id="icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="17" x2="20" y2="17"/>
        </svg>
        <svg id="icon-close" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

    </div>

    <!-- Mobile dropdown -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-[#1a1a1a] py-4">
      <div class="flex flex-col gap-1">
        <a href="#features" class="px-3 py-2 text-sm text-[#525252] hover:text-[#9a9a9a] rounded-md transition-colors">Features</a>
        <a href="#how-it-works" class="px-3 py-2 text-sm text-[#525252] hover:text-[#9a9a9a] rounded-md transition-colors">How it works</a>
        <a href="#pricing" class="px-3 py-2 text-sm text-[#525252] hover:text-[#9a9a9a] rounded-md transition-colors">Pricing</a>
        <div class="mt-3 px-3">
          <a href="#" class="block text-center px-4 py-2.5 bg-[#F5F0E8] hover:bg-white text-[#0f0f0f] text-sm font-medium rounded-md transition-colors">
            Get started free
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>
