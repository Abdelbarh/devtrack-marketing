---
---
<nav
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-all duration-300"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
        <div class="w-7 h-7 bg-[#22c55e] rounded-md flex items-center justify-center font-bold text-black text-sm leading-none select-none">
          D
        </div>
        <span class="font-semibold text-[#e5e5e5] text-sm tracking-tight">DevTrack</span>
      </a>

      <!-- Desktop navigation -->
      <div class="hidden md:flex items-center gap-7">
        <a href="#features" class="text-sm text-[#737373] hover:text-[#e5e5e5] transition-colors duration-150">
          Features
        </a>
        <a href="#how-it-works" class="text-sm text-[#737373] hover:text-[#e5e5e5] transition-colors duration-150">
          How it works
        </a>
        <a href="#pricing" class="text-sm text-[#737373] hover:text-[#e5e5e5] transition-colors duration-150">
          Pricing
        </a>
        <a
          href="https://github.com/Abdelbarh/devtrack-marketing"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#737373] hover:text-[#e5e5e5] transition-colors duration-150"
          aria-label="GitHub repository"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>

      <!-- Desktop CTA -->
      <div class="hidden md:block">
        <a
          href="#"
          class="px-4 py-2 bg-[#22c55e] hover:bg-[#16a34a] text-black text-sm font-semibold rounded-lg transition-colors duration-150 inline-block"
        >
          Get started free
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-1.5 text-[#737373] hover:text-[#e5e5e5] transition-colors"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="17" x2="20" y2="17"/>
        </svg>
        <svg id="icon-close" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

    </div>

    <!-- Mobile menu dropdown -->
    <div
      id="mobile-menu"
      class="hidden md:hidden border-t border-[#1f1f1f] py-4"
    >
      <div class="flex flex-col gap-1">
        <a href="#features" class="px-3 py-2 text-sm text-[#a3a3a3] hover:text-white hover:bg-[#111] rounded-lg transition-colors">Features</a>
        <a href="#how-it-works" class="px-3 py-2 text-sm text-[#a3a3a3] hover:text-white hover:bg-[#111] rounded-lg transition-colors">How it works</a>
        <a href="#pricing" class="px-3 py-2 text-sm text-[#a3a3a3] hover:text-white hover:bg-[#111] rounded-lg transition-colors">Pricing</a>
        <a
          href="https://github.com/Abdelbarh/devtrack-marketing"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-2 text-sm text-[#a3a3a3] hover:text-white hover:bg-[#111] rounded-lg transition-colors flex items-center gap-2"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <div class="mt-2 px-3">
          <a
            href="#"
            class="w-full block text-center px-4 py-2.5 bg-[#22c55e] hover:bg-[#16a34a] text-black text-sm font-semibold rounded-lg transition-colors"
          >
            Get started free
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>
