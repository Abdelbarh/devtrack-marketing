---
---
<nav
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-all duration-300"
>
  <div class="max-w-container mx-auto px-6">
    <div class="flex items-center h-16 gap-8">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 flex-shrink-0 group">
        <img src="/logos/devtrack-mark.svg" alt="DevTrack" class="w-7 h-7" />
        <span class="font-semibold text-[#f0f0f0] text-[15px] tracking-tight">DevTrack</span>
      </a>

      <!-- Desktop nav links (center) -->
      <div class="hidden md:flex items-center gap-1 ml-2">
        <a href="#features" class="px-3 py-1.5 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] rounded-md hover:bg-[#131316] transition-all duration-150">Features</a>
        <a href="#how-it-works" class="px-3 py-1.5 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] rounded-md hover:bg-[#131316] transition-all duration-150">How it works</a>
        <a href="#pricing" class="px-3 py-1.5 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] rounded-md hover:bg-[#131316] transition-all duration-150">Pricing</a>
        <a href="#faq" class="px-3 py-1.5 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] rounded-md hover:bg-[#131316] transition-all duration-150">FAQ</a>
      </div>

      <!-- Spacer -->
      <div class="flex-1"></div>

      <!-- Auth CTAs -->
      <div class="hidden md:flex items-center gap-2">
        <a href="#" class="px-3.5 py-2 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] transition-colors rounded-md hover:bg-[#131316]">
          Log in
        </a>
        <a
          href="#"
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#a3e635] hover:bg-[#8bcf2a] text-[#0c0c0e] text-sm font-semibold rounded-lg transition-colors duration-150"
        >
          Start free
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Mobile button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-[#a0a0a8] hover:text-[#f0f0f0] hover:bg-[#131316] rounded-md transition-all"
        aria-label="Toggle menu"
      >
        <svg id="icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/>
        </svg>
        <svg id="icon-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#26262b] bg-[#0c0c0e] px-6 py-4">
    <div class="flex flex-col gap-1">
      <a href="#features" class="px-3 py-2 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] rounded-md hover:bg-[#131316] transition-all">Features</a>
      <a href="#how-it-works" class="px-3 py-2 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] rounded-md hover:bg-[#131316] transition-all">How it works</a>
      <a href="#pricing" class="px-3 py-2 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] rounded-md hover:bg-[#131316] transition-all">Pricing</a>
      <a href="#faq" class="px-3 py-2 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] rounded-md hover:bg-[#131316] transition-all">FAQ</a>
      <div class="mt-3 pt-3 border-t border-[#1e1e22] flex flex-col gap-2">
        <a href="#" class="px-3 py-2 text-sm text-[#a0a0a8] hover:text-[#f0f0f0] rounded-md hover:bg-[#131316] transition-all">Log in</a>
        <a href="#" class="px-4 py-2.5 bg-[#a3e635] hover:bg-[#8bcf2a] text-[#0c0c0e] text-sm font-semibold rounded-lg transition-colors text-center">Start free</a>
      </div>
    </div>
  </div>
</nav>
