---
const problems = [
  {
    text: 'Every application takes 20–45 minutes of copy-pasting your resume into a slightly different format. Multiply that by 40 applications and you\'ve lost a full week of your life to Ctrl+C, Ctrl+V.',
  },
  {
    text: 'Huntr, Teal, Simplify — none of them know what FastAPI is. They can\'t tell a senior role from a mid-level one. They\'re built for everyone, which means they\'re built for no one.',
  },
  {
    text: 'You followed up, right? You\'re sure you did. Probably. Maybe. Two weeks ago you were excited about that role. Now you can\'t even find the email thread.',
  },
];
---
<section class="py-24 px-5 sm:px-8 border-t border-[#1a1a1a]">
  <div class="max-w-5xl mx-auto">

    <p data-animate class="text-sm text-[#525252] mb-5">the problem</p>

    <h2
      data-animate
      data-delay="100"
      class="font-serif text-3xl sm:text-4xl text-[#F5F0E8] leading-tight max-w-xl"
    >
      The job hunt is broken for developers
    </h2>

    <p
      data-animate
      data-delay="200"
      class="mt-4 text-[#525252] max-w-sm text-sm"
    >
      Generic tools treat you like any other applicant. You are not.
    </p>

    <!-- Editorial pain points -->
    <div
      data-stagger
      class="mt-14 flex flex-col gap-10 max-w-2xl"
    >
      {problems.map((p) => (
        <div
          data-animate
          class="pl-6 border-l-[3px] border-[#C8A96E]/35"
        >
          <p class="text-[#737373] leading-[1.85] text-base sm:text-lg">{p.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>
