---
const values = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>`,
    title: 'Centralize your search',
    text: 'Keep every role, note, document, and status in one place.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: 'Know your fit',
    text: 'Parse job descriptions and see how well the role matches your profile.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>`,
    title: 'Never miss a follow-up',
    text: 'Stay on top of applications, interviews, and reminders.',
  },
];
---
<section class="py-8 px-6 border-y border-[#1e1e22] bg-[#0e0e11]">
  <div class="max-w-container mx-auto">
    <div class="grid sm:grid-cols-3 gap-px bg-[#1e1e22] rounded-xl overflow-hidden">
      {values.map((v, i) => (
        <div
          data-animate
          data-delay={String(i)}
          class="bg-[#0e0e11] px-6 py-6 flex items-start gap-4 hover:bg-[#131316] transition-colors duration-200"
        >
          <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-[#131316] border border-[#26262b] flex items-center justify-center text-[#a3e635]">
            <Fragment set:html={v.icon} />
          </div>
          <div>
            <h3 class="text-sm font-semibold text-[#f0f0f0] mb-1">{v.title}</h3>
            <p class="text-sm text-[#5a5a64] leading-relaxed">{v.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
