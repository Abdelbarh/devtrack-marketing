---
---
<section class="py-24 px-4 sm:px-6 lg:px-8 border-t border-[#1a1a1a]">
  <div class="max-w-3xl mx-auto text-center">

    <!-- Glow -->
    <div class="pointer-events-none absolute inset-x-0 flex justify-center" aria-hidden="true">
      <div class="w-96 h-32 bg-[radial-gradient(ellipse_at_center,rgba(34,197,94,0.08)_0%,transparent_70%)] blur-2xl"></div>
    </div>

    <div data-animate>
      <span class="inline-block px-3 py-1 mb-6 bg-[#0f1a0f] border border-[#22c55e]/20 rounded-full text-xs font-mono text-[#22c55e]/80">
        38 minutes per application → under 5
      </span>
    </div>

    <h2
      data-animate
      data-delay="100"
      class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight"
    >
      Stop spending 40 minutes<br class="hidden sm:block" />
      per application
    </h2>

    <p
      data-animate
      data-delay="200"
      class="mt-5 text-base sm:text-lg text-[#737373]"
    >
      DevTrack is free to start. No credit card required.
    </p>

    <div
      data-animate
      data-delay="300"
      class="mt-8"
    >
      <a
        href="#"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-[#22c55e] hover:bg-[#16a34a] text-black font-semibold rounded-lg transition-colors duration-150 text-base"
      >
        Get started free
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
