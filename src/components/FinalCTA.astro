---
---
<section class="py-28 px-5 sm:px-8 border-t border-[#1a1a1a]">
  <div class="max-w-5xl mx-auto">

    <h2
      data-animate
      class="font-serif text-4xl sm:text-5xl lg:text-6xl text-[#F5F0E8] leading-[1.08] tracking-tight max-w-2xl"
    >
      Your next application<br/>takes 5 minutes.<br/>
      <span class="text-[#C8A96E]">Not 40.</span>
    </h2>

    <p
      data-animate
      data-delay="150"
      class="mt-6 text-[#525252] text-base max-w-xs"
    >
      DevTrack is free to start. No credit card required.
    </p>

    <div
      data-animate
      data-delay="300"
      class="mt-8"
    >
      <a
        href="#"
        class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#F5F0E8] hover:bg-white text-[#0f0f0f] font-medium rounded-md transition-colors duration-150 text-sm"
      >
        Get started free
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
