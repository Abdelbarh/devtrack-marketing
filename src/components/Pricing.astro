---
const freeFeatures = [
  'Up to 3 tracked applications',
  'Manual pipeline tracking',
  'No AI features',
];

const proFeatures = [
  'Unlimited applications',
  'AI JD parsing on every job',
  'Match scoring against your profile',
  'Resume generation + PDF export',
  'Cover letter generation',
  'Automated follow-up reminder emails',
  'Priority support',
];
---
<section id="pricing" class="py-24 px-5 sm:px-8 border-t border-[#1a1a1a]">
  <div class="max-w-4xl mx-auto">

    <p data-animate class="text-sm text-[#525252] mb-5">pricing</p>

    <h2
      data-animate
      data-delay="100"
      class="font-serif text-3xl sm:text-4xl text-[#F5F0E8] leading-tight"
    >
      One price. No tricks.
    </h2>

    <p
      data-animate
      data-delay="200"
      class="mt-4 text-[#525252] max-w-sm text-sm"
    >
      Start free. Upgrade when you're getting real value. €12/month is less than a tech book.
    </p>

    <!-- Pricing cards -->
    <div
      data-stagger
      class="mt-12 grid sm:grid-cols-2 gap-5"
    >

      <!-- Free -->
      <div
        data-animate
        class="flex flex-col p-7 bg-[#0f0f0f] border border-[#222] rounded-lg"
      >
        <div>
          <p class="text-xs text-[#525252] uppercase tracking-wide mb-3">Free</p>
          <div class="flex items-end gap-1.5">
            <span class="text-4xl font-serif text-[#F5F0E8]">€0</span>
            <span class="text-[#383838] text-sm mb-0.5">/ forever</span>
          </div>
        </div>

        <ul class="mt-8 flex-1 flex flex-col gap-3.5">
          {freeFeatures.map((f) => (
            <li class="flex items-start gap-3 text-sm text-[#525252]">
              <span class="mt-1 w-1 h-1 rounded-full bg-[#383838] flex-shrink-0"></span>
              {f}
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <a
            href="#"
            class="w-full block text-center px-5 py-2.5 border border-[#222] hover:border-[#333] text-[#525252] hover:text-[#737373] text-sm rounded-md transition-colors duration-150"
          >
            Get started free
          </a>
        </div>
      </div>

      <!-- Pro -->
      <div
        data-animate
        data-delay="100"
        class="flex flex-col p-7 bg-[#0f0f0f] border border-[#F5F0E8]/15 rounded-lg"
      >
        <div>
          <p class="text-xs text-[#9a9a9a] uppercase tracking-wide mb-3">Pro</p>
          <div class="flex items-end gap-1.5">
            <span class="text-4xl font-serif text-[#F5F0E8]">€12</span>
            <span class="text-[#383838] text-sm mb-0.5">/ month</span>
          </div>
        </div>

        <ul class="mt-8 flex-1 flex flex-col gap-3.5">
          {proFeatures.map((f) => (
            <li class="flex items-start gap-3 text-sm text-[#737373]">
              <span class="mt-1 w-1 h-1 rounded-full bg-[#C8A96E]/60 flex-shrink-0"></span>
              {f}
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <a
            href="#"
            class="w-full block text-center px-5 py-2.5 bg-[#F5F0E8] hover:bg-white text-[#0f0f0f] text-sm font-medium rounded-md transition-colors duration-150"
          >
            Start Pro
          </a>
        </div>
      </div>

    </div>

    <p
      data-animate
      data-delay="200"
      class="mt-7 text-xs text-[#383838]"
    >
      No trial period tricks. Free tier is genuinely free. Cancel Pro anytime — no retention email, no "are you sure?" dialogs.
    </p>

  </div>
</section>
