---
const freeFeatures = [
  'Up to 3 tracked applications',
  'Manual pipeline tracking',
  'No AI features',
];

const proFeatures = [
  'Unlimited applications',
  'AI JD parsing on every job',
  'Match scoring against your profile',
  'Resume generation + PDF export',
  'Cover letter generation',
  'Automated follow-up reminder emails',
  'Priority support',
];
---
<section id="pricing" class="py-24 px-4 sm:px-6 lg:px-8 border-t border-[#1a1a1a]">
  <div class="max-w-4xl mx-auto">

    <!-- Section header -->
    <div data-animate class="text-center mb-4">
      <span class="text-xs text-[#22c55e] font-medium uppercase tracking-widest font-mono">Pricing</span>
    </div>
    <h2
      data-animate
      data-delay="100"
      class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white leading-tight text-center"
    >
      Simple pricing. No nonsense.
    </h2>
    <p
      data-animate
      data-delay="200"
      class="mt-4 text-[#737373] text-center max-w-md mx-auto"
    >
      Start free. Upgrade when you're getting value. €12/month is less than a tech book.
    </p>

    <!-- Cards -->
    <div
      data-stagger
      class="mt-12 grid sm:grid-cols-2 gap-5"
    >

      <!-- Free -->
      <div
        data-animate
        class="flex flex-col p-7 bg-[#0f0f0f] border border-[#1f1f1f] rounded-xl"
      >
        <div>
          <h3 class="text-sm font-semibold text-[#a3a3a3] uppercase tracking-wider">Free</h3>
          <div class="mt-3 flex items-end gap-1">
            <span class="text-4xl font-bold text-white">€0</span>
            <span class="text-[#525252] mb-1 text-sm">/ forever</span>
          </div>
          <p class="mt-2 text-xs text-[#525252]">Get started with no strings attached.</p>
        </div>

        <ul class="mt-7 flex-1 flex flex-col gap-3">
          {freeFeatures.map((f) => (
            <li class="flex items-start gap-3 text-sm text-[#737373]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" class="mt-0.5 flex-shrink-0" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {f}
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <a
            href="#"
            class="w-full block text-center px-5 py-2.5 border border-[#2a2a2a] hover:border-[#3a3a3a] text-[#a3a3a3] hover:text-white text-sm font-medium rounded-lg transition-colors duration-150"
          >
            Get started free
          </a>
        </div>
      </div>

      <!-- Pro (highlighted) -->
      <div
        data-animate
        data-delay="100"
        class="pricing-pro relative flex flex-col p-7 bg-[#0f0f0f] border border-[#22c55e]/40 rounded-xl shadow-[0_0_30px_rgba(34,197,94,0.06)]"
      >
        <!-- Badge -->
        <div class="absolute top-5 right-5">
          <span class="px-2.5 py-0.5 bg-[#0f1a0f] border border-[#22c55e]/30 rounded-full text-xs text-[#22c55e] font-medium">
            Most value
          </span>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-[#22c55e] uppercase tracking-wider">Pro</h3>
          <div class="mt-3 flex items-end gap-1">
            <span class="text-4xl font-bold text-white">€12</span>
            <span class="text-[#525252] mb-1 text-sm">/ month</span>
          </div>
          <p class="mt-2 text-xs text-[#525252]">Cancel any time. No questions asked.</p>
        </div>

        <ul class="mt-7 flex-1 flex flex-col gap-3">
          {proFeatures.map((f) => (
            <li class="flex items-start gap-3 text-sm text-[#a3a3a3]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" class="mt-0.5 flex-shrink-0" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {f}
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <a
            href="#"
            class="w-full block text-center px-5 py-2.5 bg-[#22c55e] hover:bg-[#16a34a] text-black text-sm font-semibold rounded-lg transition-colors duration-150"
          >
            Start Pro
          </a>
        </div>
      </div>

    </div>

    <!-- Honest note -->
    <p
      data-animate
      data-delay="200"
      class="mt-7 text-center text-xs text-[#525252]"
    >
      No trial period tricks. Free tier is genuinely free. Cancel Pro anytime — no retention email, no "are you sure?" dialogs.
    </p>

  </div>
</section>
