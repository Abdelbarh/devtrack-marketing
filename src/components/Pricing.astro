---
const freePlan = {
  name: 'Free',
  price: '€0',
  subtitle: 'For getting started',
  cta: 'Start free',
  features: [
    'Track up to 50 applications',
    'Basic JD parsing',
    'Basic match scoring',
    'Pipeline tracking',
    'Follow-up reminders',
  ],
};

const proPlan = {
  name: 'Pro',
  price: '€12',
  period: '/ month',
  subtitle: 'For serious job seekers',
  cta: 'Upgrade to Pro',
  features: [
    'Unlimited applications',
    'Advanced match insights',
    'Resume tailoring',
    'Cover letter generation',
    'Priority support',
  ],
};
---
<section id="pricing" class="py-20 px-6">
  <div class="max-w-container mx-auto">

    <div class="text-center mb-12">
      <div data-animate class="mb-3">
        <span class="text-xs font-semibold text-[#a3e635] uppercase tracking-widest">Pricing</span>
      </div>
      <h2
        data-animate
        data-delay="1"
        class="text-3xl sm:text-[2.25rem] font-bold text-[#f0f0f0] leading-tight tracking-tight"
      >
        Start free. Upgrade when it matters.
      </h2>
      <p
        data-animate
        data-delay="2"
        class="mt-4 text-[16px] text-[#a0a0a8] max-w-md mx-auto"
      >
        No lock-in. Cancel or downgrade whenever you like.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 max-w-3xl mx-auto">

      <!-- Free plan -->
      <div
        data-animate
        class="flex flex-col p-7 bg-[#131316] border border-[#26262b] rounded-xl"
      >
        <div class="mb-6">
          <p class="text-sm font-semibold text-[#a0a0a8] mb-3">{freePlan.name}</p>
          <div class="flex items-end gap-1.5">
            <span class="text-4xl font-bold text-[#f0f0f0] leading-none">{freePlan.price}</span>
            <span class="text-sm text-[#5a5a64] pb-0.5">forever</span>
          </div>
          <p class="text-sm text-[#5a5a64] mt-1.5">{freePlan.subtitle}</p>
        </div>

        <ul class="flex-1 flex flex-col gap-3 mb-7">
          {freePlan.features.map(f => (
            <li class="flex items-start gap-3 text-sm text-[#a0a0a8]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5a5a64" stroke-width="2.5" stroke-linecap="round" class="mt-0.5 flex-shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {f}
            </li>
          ))}
        </ul>

        <a
          href="#"
          class="block text-center px-5 py-3 bg-[#1a1a1e] hover:bg-[#222226] border border-[#36363b] hover:border-[#46464b] text-[#f0f0f0] text-sm font-semibold rounded-lg transition-all duration-150"
        >
          {freePlan.cta}
        </a>
      </div>

      <!-- Pro plan (highlighted) -->
      <div
        data-animate
        data-delay="1"
        class="flex flex-col p-7 bg-[#131316] border border-[#a3e635]/30 rounded-xl relative overflow-hidden"
        style="box-shadow: 0 0 0 1px rgba(163,230,53,0.08), 0 8px 32px rgba(163,230,53,0.06);"
      >
        <!-- Subtle lime tint at top -->
        <div class="absolute top-0 left-0 right-0 h-px bg-[#a3e635]/40" aria-hidden="true"></div>

        <!-- Popular badge -->
        <div class="absolute top-5 right-5">
          <span class="px-2.5 py-1 bg-[#a3e635]/10 border border-[#a3e635]/20 text-[#a3e635] text-[10px] font-semibold rounded-full uppercase tracking-wide">
            Popular
          </span>
        </div>

        <div class="mb-6">
          <p class="text-sm font-semibold text-[#a3e635] mb-3">{proPlan.name}</p>
          <div class="flex items-end gap-1.5">
            <span class="text-4xl font-bold text-[#f0f0f0] leading-none">{proPlan.price}</span>
            <span class="text-sm text-[#5a5a64] pb-0.5">{proPlan.period}</span>
          </div>
          <p class="text-sm text-[#5a5a64] mt-1.5">{proPlan.subtitle}</p>
        </div>

        <ul class="flex-1 flex flex-col gap-3 mb-7">
          {proPlan.features.map(f => (
            <li class="flex items-start gap-3 text-sm text-[#a0a0a8]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a3e635" stroke-width="2.5" stroke-linecap="round" class="mt-0.5 flex-shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {f}
            </li>
          ))}
        </ul>

        <a
          href="#"
          class="block text-center px-5 py-3 bg-[#a3e635] hover:bg-[#8bcf2a] text-[#0c0c0e] text-sm font-semibold rounded-lg transition-colors duration-150"
        >
          {proPlan.cta}
        </a>
      </div>
    </div>

    <p
      data-animate
      class="mt-8 text-center text-xs text-[#5a5a64]"
    >
      No credit card required to start. Cancel Pro anytime.
    </p>

  </div>
</section>
