---
---
<section class="py-12 px-4 sm:px-6 lg:px-8 border-b border-[#1a1a1a]">
  <div class="max-w-5xl mx-auto">

    <div data-animate class="text-center mb-6">
      <p class="text-sm text-[#525252] uppercase tracking-widest font-medium">
        Join the first developers using DevTrack
      </p>
    </div>

    <div
      data-animate
      data-delay="150"
      data-stagger
      class="flex flex-wrap items-center justify-center gap-3 sm:gap-4"
    >
      <!-- Claude AI -->
      <div data-animate class="flex items-center gap-2 px-4 py-2 bg-[#0f0f0f] border border-[#1f1f1f] rounded-lg">
        <svg width="16" height="16" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="6" fill="#D97706"/>
          <path d="M16 8C11.582 8 8 11.582 8 16s3.582 8 8 8 8-3.582 8-8-3.582-8-8-8zm0 14c-3.314 0-6-2.686-6-6s2.686-6 6-6 6 2.686 6 6-2.686 6-6 6z" fill="white"/>
        </svg>
        <span class="text-xs text-[#737373] font-medium">Powered by Claude AI</span>
      </div>

      <!-- .NET 9 -->
      <div data-animate class="flex items-center gap-2 px-4 py-2 bg-[#0f0f0f] border border-[#1f1f1f] rounded-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect width="24" height="24" rx="4" fill="#512BD4"/>
          <text x="12" y="16" text-anchor="middle" font-family="monospace" font-size="9" font-weight="700" fill="white">.NET</text>
        </svg>
        <span class="text-xs text-[#737373] font-medium">.NET 9 backend</span>
      </div>

      <!-- PostgreSQL -->
      <div data-animate class="flex items-center gap-2 px-4 py-2 bg-[#0f0f0f] border border-[#1f1f1f] rounded-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect width="24" height="24" rx="4" fill="#336791"/>
          <ellipse cx="12" cy="8" rx="6" ry="3" fill="white" opacity="0.9"/>
          <path d="M6 8v4c0 1.657 2.686 3 6 3s6-1.343 6-3V8" stroke="white" stroke-opacity="0.9" stroke-width="1.5" fill="none"/>
          <path d="M6 12v4c0 1.657 2.686 3 6 3s6-1.343 6-3v-4" stroke="white" stroke-opacity="0.6" stroke-width="1.5" fill="none"/>
        </svg>
        <span class="text-xs text-[#737373] font-medium">PostgreSQL</span>
      </div>

      <!-- Clerk -->
      <div data-animate class="flex items-center gap-2 px-4 py-2 bg-[#0f0f0f] border border-[#1f1f1f] rounded-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect width="24" height="24" rx="4" fill="#6C47FF"/>
          <circle cx="12" cy="9" r="3.5" fill="white"/>
          <path d="M5 20c0-3.866 3.134-7 7-7s7 3.134 7 7" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none"/>
        </svg>
        <span class="text-xs text-[#737373] font-medium">Auth by Clerk</span>
      </div>

      <!-- Anthropic -->
      <div data-animate class="flex items-center gap-2 px-4 py-2 bg-[#0f0f0f] border border-[#1f1f1f] rounded-lg">
        <div class="w-4 h-4 rounded-sm bg-[#cc785c] flex items-center justify-center" aria-hidden="true">
          <div class="w-2 h-2 bg-white rounded-full"></div>
        </div>
        <span class="text-xs text-[#737373] font-medium">Anthropic</span>
      </div>
    </div>

  </div>
</section>
