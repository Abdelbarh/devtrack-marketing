---
---
<section class="py-20 px-6 bg-[#0A0D1A] border-y border-[#1A1E32]">
  <div class="max-w-container mx-auto">

    <div class="max-w-2xl mb-12">
      <p data-animate class="text-xs font-semibold text-[#6366F1] uppercase tracking-widest mb-4 font-display">Product</p>
      <h2 data-animate data-delay="1" class="font-display text-3xl sm:text-4xl font-bold text-[#E8EEFF] leading-tight">
        One workspace for your entire search.
      </h2>
      <p data-animate data-delay="2" class="mt-4 text-[16px] text-[#7B82AF] leading-relaxed">
        From the first job post to the final interview, DevTrack keeps your applications structured, searchable, and actionable.
      </p>
    </div>

    <div data-animate data-delay="1" class="relative">
      <div class="absolute -inset-px rounded-2xl bg-[#6366F1]/5 blur-xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative rounded-xl border border-[#212840] bg-[#07090F] overflow-hidden" style="box-shadow: 0 32px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(99,102,241,0.06);">

        <!-- Browser chrome -->
        <div class="flex items-center gap-3 h-10 px-4 bg-[#07090F] border-b border-[#1A1E32]">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-[#1A1E32]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#1A1E32]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#1A1E32]"></div>
          </div>
          <div class="ml-2 flex-1 h-5 bg-[#0D1020] rounded border border-[#1A1E32] flex items-center px-2.5 max-w-[280px]">
            <span class="text-[10px] text-[#3D4468]">app.devtrack.io/applications</span>
          </div>
        </div>

        <!-- App layout -->
        <div class="flex" style="min-height: 440px;">

          <!-- Sidebar -->
          <div class="w-[52px] sm:w-[180px] flex-shrink-0 bg-[#07090F] border-r border-[#1A1E32] flex flex-col py-3">
            <div class="hidden sm:flex items-center gap-2 px-3 mb-5">
              <div class="w-5 h-5 bg-[#6366F1] rounded-[5px] flex items-center justify-center flex-shrink-0">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <span class="text-[11px] font-semibold text-[#E8EEFF] font-display">DevTrack</span>
            </div>

            <div class="flex flex-col gap-0.5 px-1.5 sm:px-2">
              {[
                { icon: 'M4 6h16M4 10h16M4 14h16M4 18h16', label: 'Dashboard', active: false },
                { icon: 'M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z', label: 'Applications', active: true },
                { icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2', label: 'Documents', active: false },
                { icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9', label: 'Reminders', active: false },
              ].map(item => (
                <div class={`flex items-center gap-2 px-1.5 sm:px-2 py-1.5 rounded-md text-[10px] sm:text-[11px] cursor-pointer transition-colors ${item.active ? 'bg-[#6366F1]/10 text-[#818CF8]' : 'text-[#3D4468] hover:bg-[#0D1020] hover:text-[#7B82AF]'}`}>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="flex-shrink-0" aria-hidden="true">
                    <path d={item.icon}/>
                  </svg>
                  <span class="hidden sm:inline truncate">{item.label}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Main panel -->
          <div class="flex-1 overflow-hidden flex flex-col min-w-0">

            <!-- Topbar -->
            <div class="flex items-center justify-between px-4 sm:px-6 py-3 border-b border-[#1A1E32] flex-shrink-0 gap-4">
              <h2 class="text-sm font-semibold text-[#E8EEFF]">Applications</h2>
              <div class="flex items-center gap-2">
                <div class="hidden sm:flex items-center gap-1.5 bg-[#07090F] border border-[#1A1E32] rounded-md px-3 py-1.5 w-48">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#3D4468" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                  <span class="text-[11px] text-[#3D4468]">Search roles...</span>
                </div>
                <button class="flex items-center gap-1.5 px-3 py-1.5 bg-[#6366F1] hover:bg-[#5558E8] text-white text-[11px] font-bold rounded-md transition-colors">
                  <span>+</span><span class="hidden sm:inline">Add application</span><span class="sm:hidden">Add</span>
                </button>
              </div>
            </div>

            <!-- Status filter pills -->
            <div class="flex items-center gap-2 px-4 sm:px-6 py-3 border-b border-[#1A1E32] flex-shrink-0 overflow-x-auto">
              <span class="px-2.5 py-1 bg-[#6366F1]/10 text-[#818CF8] text-[11px] rounded-full border border-[#6366F1]/25 cursor-pointer whitespace-nowrap font-medium">All (12)</span>
              {['Saved (3)', 'Applied (5)', 'Screening (2)', 'Interview (1)', 'Offer (1)'].map(label => (
                <span class="px-2.5 py-1 bg-[#0D1020] text-[#4A5080] text-[11px] rounded-full border border-[#212840] cursor-pointer whitespace-nowrap hover:border-[#2e3658] transition-colors">{label}</span>
              ))}
            </div>

            <!-- Table header -->
            <div class="hidden sm:grid gap-4 px-6 py-2.5 border-b border-[#1A1E32] bg-[#07090F] flex-shrink-0" style="grid-template-columns: 1.2fr 1.5fr 100px 64px 80px;">
              {['Company', 'Role', 'Status', 'Score', 'Applied'].map(h => (
                <span class="text-[10px] font-semibold text-[#3D4468] uppercase tracking-wide">{h}</span>
              ))}
            </div>

            <!-- Rows -->
            <div class="flex-1 overflow-auto divide-y divide-[#131828]">
              {[
                { co: 'Stripe', coColor: '#818CF8', role: 'Backend Engineer III', tags: ['Python', 'FastAPI', 'PostgreSQL'], tagColors: ['#10B981', '#818CF8', '#10B981'], status: 'Applied', statusBg: '#F59E0B18', statusText: '#F59E0B', score: 87, scoreColor: '#818CF8', date: '2w ago' },
                { co: 'Vercel', coColor: '#E8EEFF', role: 'Full Stack Developer', tags: ['React', 'Next.js', 'TypeScript'], tagColors: ['#38BDF8', '#7B82AF', '#818CF8'], status: 'Saved', statusBg: '#1A1E3280', statusText: '#4A5080', score: 72, scoreColor: '#F59E0B', date: '3d ago' },
                { co: 'Datadog', coColor: '#F59E0B', role: 'Senior Software Engineer', tags: ['Go', 'Python', 'K8s'], tagColors: ['#10B981', '#818CF8', '#38BDF8'], status: 'Screening', statusBg: '#F59E0B18', statusText: '#F59E0B', score: 91, scoreColor: '#10B981', date: '1w ago' },
                { co: 'Linear', coColor: '#818CF8', role: 'Backend Developer', tags: ['TypeScript', '.NET', 'React'], tagColors: ['#818CF8', '#10B981', '#38BDF8'], status: 'Interview', statusBg: '#6366F118', statusText: '#818CF8', score: 95, scoreColor: '#10B981', date: '5d ago' },
                { co: 'Shopify', coColor: '#10B981', role: 'API Engineer', tags: ['Ruby', 'GraphQL', 'PostgreSQL'], tagColors: ['#F87171', '#F59E0B', '#10B981'], status: 'Applied', statusBg: '#F59E0B18', statusText: '#F59E0B', score: 68, scoreColor: '#7B82AF', date: '4d ago' },
                { co: 'GitHub', coColor: '#E8EEFF', role: 'Software Engineer, Copilot', tags: ['Python', 'FastAPI', 'C#'], tagColors: ['#10B981', '#818CF8', '#818CF8'], status: 'Offer', statusBg: '#10B98118', statusText: '#10B981', score: 89, scoreColor: '#10B981', date: '3w ago' },
              ].map(row => (
                <div class="grid gap-4 px-4 sm:px-6 py-3 hover:bg-[#0D1020] transition-colors cursor-pointer" style="grid-template-columns: auto 1fr;">
                  <div class="sm:hidden col-span-2 flex items-start gap-3">
                    <div class="w-7 h-7 rounded-md bg-[#131828] border border-[#212840] flex items-center justify-center flex-shrink-0">
                      <span class="text-[9px] font-bold" style={`color: ${row.coColor}`}>{row.co.slice(0,2)}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between gap-2">
                        <span class="text-[12px] font-semibold text-[#E8EEFF] truncate">{row.co}</span>
                        <span class="px-2 py-0.5 text-[9px] rounded-full font-medium flex-shrink-0" style={`color:${row.statusText};background:${row.statusBg}`}>{row.status}</span>
                      </div>
                      <div class="text-[11px] text-[#7B82AF] truncate mt-0.5">{row.role}</div>
                    </div>
                  </div>
                  <div class="hidden sm:grid gap-4 col-span-2" style="grid-template-columns: 1.2fr 1.5fr 100px 64px 80px;">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div class="w-6 h-6 rounded-md bg-[#131828] border border-[#212840] flex items-center justify-center flex-shrink-0">
                        <span class="text-[8px] font-bold" style={`color: ${row.coColor}`}>{row.co.slice(0,2)}</span>
                      </div>
                      <span class="text-[12px] font-medium text-[#E8EEFF] truncate">{row.co}</span>
                    </div>
                    <div class="min-w-0">
                      <div class="text-[12px] text-[#7B82AF] truncate">{row.role}</div>
                      <div class="flex gap-1 mt-1 flex-wrap">
                        {row.tags.map((tag, ti) => (
                          <span class="px-1.5 py-0.5 text-[8px] rounded font-medium" style={`color:${row.tagColors[ti]};background:${row.tagColors[ti]}18`}>{tag}</span>
                        ))}
                      </div>
                    </div>
                    <div class="flex items-center">
                      <span class="px-2 py-0.5 text-[9px] rounded-full font-medium" style={`color:${row.statusText};background:${row.statusBg}`}>{row.status}</span>
                    </div>
                    <div class="flex items-center text-[13px] font-bold" style={`color:${row.scoreColor}`}>{row.score}</div>
                    <div class="flex items-center text-[11px] text-[#3D4468]">{row.date}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
