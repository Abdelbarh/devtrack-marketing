---
const features = [
  {
    title: 'JD Parsing',
    description: 'Paste any JD. Get company, title, stack, salary, seniority, and remote policy structured in under 2 seconds.',
  },
  {
    title: 'Match Scoring',
    description: 'See a 0–100 fit score against your profile and GitHub before you waste time applying to roles that don\'t fit.',
  },
  {
    title: 'Resume Generation',
    description: 'One-click tailored resume per application. Exported as PDF. No more resume_v12_FINAL_real_final.pdf.',
  },
  {
    title: 'Cover Letter Generation',
    description: 'Tailored to the specific JD and your actual GitHub experience. Sounds like you wrote it, not a chatbot.',
  },
  {
    title: 'Pipeline Tracking',
    description: 'Saved → Applied → Screening → Interview → Offer. Every stage, every application, one view.',
  },
  {
    title: 'Follow-up Reminders',
    description: 'Automated emails 7 days post-apply and 3 days post-interview. Because you will forget. Everyone does.',
  },
];
---
<section id="features" class="py-24 px-5 sm:px-8 border-t border-[#1a1a1a]">
  <div class="max-w-5xl mx-auto">

    <p data-animate class="text-sm text-[#525252] mb-5">features</p>

    <h2
      data-animate
      data-delay="100"
      class="font-serif text-3xl sm:text-4xl text-[#F5F0E8] leading-tight"
    >
      Six things. Each one earned.
    </h2>

    <p
      data-animate
      data-delay="200"
      class="mt-4 text-[#525252] max-w-sm text-sm"
    >
      Built around the actual job hunt workflow — not the one some PM imagined.
    </p>

    <!-- Two-column feature list -->
    <div
      data-stagger
      class="mt-12 divide-y divide-[#1a1a1a] border-t border-[#1a1a1a]"
    >
      {features.map((f) => (
        <div
          data-animate
          class="grid grid-cols-1 sm:grid-cols-[220px_1fr] gap-2 sm:gap-12 py-5 group"
        >
          <span class="text-sm font-medium text-[#F5F0E8]">{f.title}</span>
          <span class="text-sm text-[#525252] leading-relaxed">{f.description}</span>
        </div>
      ))}
    </div>

  </div>
</section>
