---
const features = [
  {
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
    title: 'One-click job parsing',
    desc: 'Paste any job URL or raw description. DevTrack extracts the role, company, location, salary, stack, and seniority level in seconds.',
    color: '#818CF8',
  },
  {
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
    title: 'Pipeline kanban',
    desc: 'Move applications through stages: Saved → Applied → Phone Screen → Interview → Offer. Drag, drop, done.',
    color: '#6366F1',
  },
  {
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
    title: 'AI cover letter generator',
    desc: 'Pulls from your GitHub activity, uploaded CV, and the job description. Tailored, editable, and ready to send.',
    color: '#10B981',
  },
  {
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    title: 'CV match scoring',
    desc: 'See how well your experience matches each role. Know before you apply whether the effort is worth it.',
    color: '#F59E0B',
  },
  {
    icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9',
    title: 'Follow-up reminders',
    desc: 'Set reminders for every stage — follow-up after applying, thank-you after interviews, check-ins on ghosted roles.',
    color: '#818CF8',
  },
  {
    icon: 'M4 6h16M4 10h16M4 14h16M4 18h16',
    title: 'Notes and context',
    desc: 'Attach recruiter names, interview notes, compensation details, and gut feelings to every application — all searchable.',
    color: '#6366F1',
  },
];
---
<section id="features" class="py-20 px-6">
  <div class="max-w-container mx-auto">

    <div class="text-center mb-14">
      <p data-animate class="text-xs font-semibold text-[#6366F1] uppercase tracking-widest mb-4 font-display">Features</p>
      <h2 data-animate data-delay="1" class="font-display text-3xl sm:text-4xl font-bold text-[#E8EEFF] leading-tight">Everything your job search needs.</h2>
      <p data-animate data-delay="2" class="mt-4 text-[16px] text-[#7B82AF] max-w-lg mx-auto">Built for developers who want signal, not spreadsheets.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f, i) => (
        <div data-animate data-delay={String(i % 3)} class="flex flex-col gap-4 p-6 bg-[#0D1020] border border-[#212840] rounded-2xl hover:border-[#6366F1]/25 transition-all duration-200">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style={`background:${f.color}12;border:1px solid ${f.color}28`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={f.color} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={f.icon}/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-[#E8EEFF] mb-2 leading-snug">{f.title}</p>
            <p class="text-sm text-[#4A5080] leading-relaxed">{f.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
