---
const features = [
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
    title: 'JD parsing',
    text: 'Extract company, role, location, seniority, salary, and required technologies from raw job descriptions.',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    title: 'Match scoring',
    text: 'See a 0–100 fit score based on your profile, projects, skills, and the job requirements.',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`,
    title: 'Resume tailoring',
    text: 'Generate role-specific resume content that focuses on the most relevant experience.',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
    title: 'Cover letters',
    text: 'Create tailored cover letters that sound specific, not generic.',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>`,
    title: 'Pipeline tracking',
    text: 'Track every application from saved to offer with a clean status workflow.',
  },
  {
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>`,
    title: 'Follow-up reminders',
    text: 'Know when to follow up after applying, interviewing, or waiting for feedback.',
  },
];
---
<section id="features" class="py-20 px-6">
  <div class="max-w-container mx-auto">

    <div class="text-center mb-12">
      <div data-animate class="mb-3">
        <span class="text-xs font-semibold text-[#a3e635] uppercase tracking-widest">Features</span>
      </div>
      <h2
        data-animate
        data-delay="1"
        class="text-3xl sm:text-[2.25rem] font-bold text-[#f0f0f0] leading-tight tracking-tight"
      >
        Everything your job search needs
      </h2>
      <p
        data-animate
        data-delay="2"
        class="mt-4 text-[16px] text-[#a0a0a8] max-w-md mx-auto"
      >
        Six focused features, built around how developers actually apply.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map((f, i) => (
        <div
          data-animate
          data-delay={String(i % 3)}
          class="group p-6 bg-[#131316] border border-[#26262b] rounded-xl hover:border-[#36363b] hover:bg-[#171719] transition-all duration-200"
        >
          <div class="w-9 h-9 rounded-lg bg-[#1a1a1e] border border-[#26262b] flex items-center justify-center text-[#a3e635] mb-4 group-hover:border-[#a3e635]/25 transition-colors">
            <Fragment set:html={f.icon} />
          </div>
          <h3 class="text-[15px] font-semibold text-[#f0f0f0] mb-2">{f.title}</h3>
          <p class="text-sm text-[#a0a0a8] leading-relaxed">{f.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>
